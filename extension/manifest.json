{
  "manifest_version": 3,
  "name": "LSDM Stream & Download Sniffer",
  "version": "2.0.0",
  "author": "LSDM Project",
  "homepage_url": "https://github.com/lsdm/lsdm",
  "description": "High-speed media sniffer and parallel download accelerator for LSDM.",
  "icons": {
    "16": "icons/icon16.png"
  },
  "permissions": [
    "downloads",
    "webRequest",
    "storage",
    "cookies",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LSDM Sniffer",
    "default_icon": {
      "16": "icons/icon16.png"
    }
  }
}