{
  "name": "lsdm",
  "author": "Terrox",
  "version": "1.0.0",
  "description": "LSDM — Light Speed Download Manager Pro",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "start:server": "node server.js --standalone",
    "test": "jest --runInBand --passWithNoTests --forceExit",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "express": "^4.18.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.lsdm.downloadmanager",
    "productName": "LSDM",
    "copyright": "Copyright © 2025 LSDM",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "server.js",
      "preload.js",
      "package.json",
      "public/**/*",
      "extension/**/*",
      "tools/**/*"
    ],
    "asarUnpack": [
      "tools/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LSDM"
    }
  }
}